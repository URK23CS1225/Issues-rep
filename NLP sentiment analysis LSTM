    },
    {
      "cell_type": "code",
      "source": [
        "def encode_review(text):\n",
        "    # Reserve indices: 0 (padding), 1 (start), 2 (OOV)\n",
        "    words = text.lower().split()\n",
        "    encoded = [word_index.get(word, 2) + 3 for word in words]  # 2 is for unknown words\n",
        "    return encoded\n"
      ],
      "metadata": {
        "id": "U2zG2p7_8xtl"
      },
      "execution_count": 11,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "\n",
        "# Example review\n",
        "review = \"The director made a great choice with the cast \"\n",
        "\n",
        "# Encode and pad\n",
        "encoded_review = encode_review(review)\n",
        "padded_review = pad_sequences([encoded_review], maxlen=200)\n",
        "\n",
        "# Predict\n",
        "prediction = model.predict(padded_review)\n",
        "print(f\"Review: {review}\")\n",
        "print(f\"Predicted Sentiment: {'Positive' if prediction[0][0] >= 0.5 else 'Negative'} (Score: {prediction[0][0]:.4f})\")\n"
      ],
